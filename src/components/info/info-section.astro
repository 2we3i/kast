---
/** One titled block of a long-form page. */
interface Props {
  heading: string;
  body: string;
}

const { heading, body } = Astro.props;
---

<section class="mt-10">
  <h2 class="font-display text-xl font-bold tracking-tight">{heading}</h2>
  <p class="mt-3 leading-relaxed text-foreground/80">{body}</p>
  <slot />
</section>
