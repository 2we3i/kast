---
import KastWordmark from "@/components/shared/kast-wordmark.astro";
import { type Locale, localizePath } from "@/i18n/routing";
import { getTranslator } from "@/i18n/translator";
import { SITE } from "@/lib/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslator(locale, "footer");
const tSidebar = getTranslator(locale, "platform.sidebar");
const year = new Date().getFullYear();

const LINKS = [
  { href: localizePath("/platform", locale), label: t("startBuilding") },
  { href: localizePath("/platform/template", locale), label: t("templates") },
  { href: localizePath("/about", locale), label: t("about") },
  { href: localizePath("/privacy", locale), label: t("privacy") },
];
---

<footer class="border-t border-foreground/15">
  <div
    class="mx-auto grid w-11/12 max-w-5xl gap-8 py-12 md:grid-cols-[1fr_auto] md:items-end"
  >
    <div>
      <KastWordmark href={localizePath("/", locale)} label={tSidebar("home")} />
      <p class="mt-3 max-w-sm text-sm text-muted-foreground">{t("tagline")}</p>
    </div>

    <nav
      aria-label={t("ariaLabel")}
      class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-muted-foreground"
    >
      {
        LINKS.map((link) => (
          <a href={link.href} class="transition-colors hover:text-foreground">
            {link.label}
          </a>
        ))
      }
      {
        SITE.sourceUrl && (
          <a
            href={SITE.sourceUrl}
            target="_blank"
            rel="noreferrer"
            class="transition-colors hover:text-foreground"
          >
            {t("github")}
          </a>
        )
      }
    </nav>
  </div>

  <div class="border-t border-foreground/10">
    <div class="mx-auto w-11/12 max-w-5xl py-5">
      <p class="font-mono text-xs text-muted-foreground">
        {t("rights", { year })}
      </p>
    </div>
  </div>
</footer>
