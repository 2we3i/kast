---
import {
  ClockCounterClockwiseIcon,
  DownloadSimpleIcon,
  FileArrowUpIcon,
  GaugeIcon,
  PaletteIcon,
  SparkleIcon,
  TranslateIcon,
  WifiSlashIcon,
} from "@phosphor-icons/react";
import type { Locale } from "@/i18n/routing";
import { getTranslator } from "@/i18n/translator";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslator(locale, "features");

const FEATURES = [
  { icon: GaugeIcon, key: "ats" },
  { icon: FileArrowUpIcon, key: "import" },
  { icon: PaletteIcon, key: "templates" },
  { icon: TranslateIcon, key: "languages" },
  { icon: SparkleIcon, key: "ai" },
  { icon: ClockCounterClockwiseIcon, key: "versions" },
  { icon: WifiSlashIcon, key: "offline" },
  { icon: DownloadSimpleIcon, key: "export" },
];
---

<section
  aria-labelledby="features-heading"
  class="mx-auto w-11/12 max-w-5xl py-20 md:py-28"
>
  <div class="landing-reveal max-w-2xl">
    <h2
      id="features-heading"
      class="font-display text-3xl font-bold tracking-tight text-balance sm:text-4xl"
    >
      {t("heading")}
    </h2>
    <p class="mt-3 text-base text-foreground/70">{t("subheading")}</p>
  </div>
  <ul
    class="landing-reveal mt-12 grid gap-px overflow-hidden rounded-xl border bg-border sm:grid-cols-2 lg:grid-cols-4"
  >
    {
      FEATURES.map((feature) => (
        <li class="flex flex-col gap-3 bg-card p-6">
          <span class="inline-flex size-10 items-center justify-center rounded-lg bg-brand text-brand-accent">
            <feature.icon className="size-5" weight="duotone" aria-hidden="true" />
          </span>
          <h3 class="font-display text-base font-bold tracking-tight">
            {t(`${feature.key}Title`)}
          </h3>
          <p class="text-sm text-muted-foreground">{t(`${feature.key}Body`)}</p>
        </li>
      ))
    }
  </ul>
</section>
