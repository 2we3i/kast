{
  "version": 1,
  "categories": {
    "structure": { "weight": 20 },
    "format": { "weight": 10 },
    "contacts": { "weight": 15 },
    "dates": { "weight": 15 },
    "content": { "weight": 25 },
    "keywords": { "weight": 15 }
  },
  "rules": [
    {
      "id": "name-present",
      "category": "structure",
      "severity": "error",
      "weight": 4
    },
    {
      "id": "headline-present",
      "category": "structure",
      "severity": "warning",
      "weight": 2
    },
    {
      "id": "required-sections",
      "category": "structure",
      "severity": "error",
      "weight": 8,
      "params": { "sections": ["experience", "education", "skills"] }
    },
    {
      "id": "summary-present",
      "category": "structure",
      "severity": "warning",
      "weight": 3
    },
    {
      "id": "standard-headings",
      "category": "structure",
      "severity": "warning",
      "weight": 3
    },
    {
      "id": "section-order",
      "category": "structure",
      "severity": "info",
      "weight": 2,
      "params": { "before": "experience", "after": "education" }
    },
    {
      "id": "ats-mode",
      "category": "format",
      "severity": "warning",
      "weight": 4
    },
    {
      "id": "special-bullets",
      "category": "format",
      "severity": "warning",
      "weight": 3,
      "params": {
        "pattern": "[★☆✓✔✗✘➤➢►▶■□◆◇●○❖✦✧→⇒♦♣♠♥☛☞✪✰]"
      }
    },
    {
      "id": "emoji",
      "category": "format",
      "severity": "warning",
      "weight": 2,
      "params": { "pattern": "\\p{Extended_Pictographic}" }
    },
    {
      "id": "letter-spacing",
      "category": "format",
      "severity": "info",
      "weight": 1,
      "params": { "max": 0.3 }
    },
    {
      "id": "email-present",
      "category": "contacts",
      "severity": "error",
      "weight": 5
    },
    {
      "id": "email-format",
      "category": "contacts",
      "severity": "error",
      "weight": 3,
      "params": { "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$" }
    },
    {
      "id": "phone-present",
      "category": "contacts",
      "severity": "warning",
      "weight": 4
    },
    {
      "id": "phone-format",
      "category": "contacts",
      "severity": "warning",
      "weight": 2,
      "params": { "pattern": "^\\+?[0-9][0-9 ()./-]{6,19}$", "minDigits": 7 }
    },
    {
      "id": "location-present",
      "category": "contacts",
      "severity": "info",
      "weight": 1
    },
    {
      "id": "dates-present",
      "category": "dates",
      "severity": "warning",
      "weight": 5
    },
    {
      "id": "dates-consistent",
      "category": "dates",
      "severity": "info",
      "weight": 3
    },
    {
      "id": "dates-order",
      "category": "dates",
      "severity": "error",
      "weight": 4
    },
    {
      "id": "employment-gaps",
      "category": "dates",
      "severity": "info",
      "weight": 2,
      "params": { "months": 6 }
    },
    {
      "id": "employment-overlaps",
      "category": "dates",
      "severity": "info",
      "weight": 1,
      "params": { "months": 1 }
    },
    {
      "id": "word-count",
      "category": "content",
      "severity": "warning",
      "weight": 4,
      "params": { "min": 150, "max": 1000 }
    },
    {
      "id": "summary-length",
      "category": "content",
      "severity": "warning",
      "weight": 4,
      "params": { "minWords": 25, "maxWords": 120 }
    },
    {
      "id": "bullets-per-entry",
      "category": "content",
      "severity": "warning",
      "weight": 5,
      "params": { "min": 2, "max": 8 }
    },
    {
      "id": "weak-phrases",
      "category": "content",
      "severity": "warning",
      "weight": 4,
      "params": {
        "phrases": {
          "en": [
            "responsible for",
            "duties included",
            "duties involved",
            "worked on",
            "helped with",
            "assisted with",
            "tasked with",
            "in charge of",
            "various tasks",
            "team player",
            "hard worker",
            "detail-oriented"
          ],
          "lt": [
            "buvau atsakingas",
            "buvau atsakinga",
            "atsakingas už",
            "atsakinga už",
            "mano pareigos",
            "dirbau su",
            "padėjau",
            "įvairios užduotys",
            "įvairūs darbai",
            "komandinis žaidėjas"
          ],
          "ru": [
            "отвечал за",
            "отвечала за",
            "в мои обязанности входило",
            "в обязанности входило",
            "занимался",
            "занималась",
            "помогал",
            "помогала",
            "различные задачи",
            "командный игрок",
            "стрессоустойчивость"
          ]
        }
      }
    },
    {
      "id": "repeated-words",
      "category": "content",
      "severity": "info",
      "weight": 2,
      "params": { "maxRepeats": 4, "minLength": 5 }
    },
    {
      "id": "quantified-results",
      "category": "content",
      "severity": "info",
      "weight": 3,
      "params": { "minRatio": 0.25, "minBullets": 3 }
    },
    {
      "id": "page-count",
      "category": "content",
      "severity": "warning",
      "weight": 3,
      "params": { "maxPages": 2 }
    },
    {
      "id": "keywords-match",
      "category": "keywords",
      "severity": "warning",
      "weight": 10,
      "params": { "goodRatio": 0.6, "topTerms": 25 }
    }
  ],
